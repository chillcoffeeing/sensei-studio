---
interface Props {
  level?: 1 | 2 | 3 | 4
  class?: string
  as?: 'h1' | 'h2' | 'h3' | 'h4'
}

const { level = 2, class: className = '', as } = Astro.props

const Tag = as || (`h${level}` as const)

const sizes = {
  1: 'text-5xl md:text-7xl lg:text-8xl font-semibold tracking-[-0.06em] leading-[0.9]',
  2: 'text-4xl md:text-5xl font-medium tracking-[-0.05em] leading-[1.05]',
  3: 'text-2xl md:text-3xl font-medium tracking-[-0.04em]',
  4: 'text-lg font-medium',
}
---

<Tag class:list={[sizes[level], className]}>
  <slot />
</Tag>
