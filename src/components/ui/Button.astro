---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'dark'
  href?: string
  class?: string
  size?: 'sm' | 'md' | 'lg'
  withArrow?: boolean
  ariaLabel?: string
}

const {
  variant = 'primary',
  href,
  class: className = '',
  size = 'md',
  withArrow = false,
  ariaLabel,
} = Astro.props

const variants = {
  primary: 'bg-lime text-ink hover:bg-white',
  secondary: 'border border-ink/30 text-ink hover:bg-ink hover:text-paper',
  dark: 'bg-panel text-white hover:bg-lime hover:text-ink',
  ghost: 'text-muted hover:text-ink',
}

const sizes = {
  sm: 'min-h-9 px-4 text-xs',
  md: 'min-h-11 px-5 text-sm',
  lg: 'min-h-14 px-7 text-base',
}

const classes = [
  'inline-flex items-center justify-center gap-3 rounded-full font-medium transition-colors duration-200',
  'cursor-pointer whitespace-nowrap',
  'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-lime',
  variants[variant],
  sizes[size],
  className,
]

const arrowClass = variant === 'dark' ? 'invert' : ''
---

{href ? (
  <a href={href} class:list={classes} aria-label={ariaLabel}>
    <slot />
    {withArrow && <img src="/assets/figma/arrow-right.svg" alt="" class:list={['h-3 w-auto', arrowClass]} aria-hidden="true" />}
  </a>
) : (
  <button type="button" class:list={classes} aria-label={ariaLabel}>
    <slot />
    {withArrow && <img src="/assets/figma/arrow-right.svg" alt="" class:list={['h-3 w-auto', arrowClass]} aria-hidden="true" />}
  </button>
)}
