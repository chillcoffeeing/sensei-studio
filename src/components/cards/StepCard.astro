---
interface Props {
  number: string
  title: string
  description: string
  class?: string
}

const { number, title, description, class: className = '' } = Astro.props
---

<li class:list={['group relative flex min-h-[14rem] flex-col justify-end overflow-hidden p-6 pt-20 transition-colors duration-300 hover:bg-white/[0.035] md:min-h-[19rem] md:p-9', className]}>
  <span class="pointer-events-none absolute right-5 top-4 text-[clamp(4.5rem,8vw,7rem)] font-semibold leading-none tracking-[-0.1em] text-white/10" aria-hidden="true">{number}</span>
  <div class="relative z-10 max-w-[23rem]">
    <h3 class="text-xl font-medium leading-[1.05] tracking-[-0.04em] text-white md:text-2xl">{title}</h3>
    <p class="mt-3 max-w-[30ch] text-sm leading-[1.45] text-white/60 md:text-base">{description}</p>
  </div>
</li>
