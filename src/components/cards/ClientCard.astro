---
interface Props {
  name: string
  logo: string
  logoKind?: 'mark' | 'wordmark'
  class?: string
}

const { name, logo, logoKind = 'wordmark', class: className = '' } = Astro.props
const isMark = logoKind === 'mark'
---

<div class:list={['flex h-10 w-40 shrink-0 items-center gap-2', isMark ? 'justify-start' : 'justify-center', className]}>
  <img
    src={logo}
    alt={isMark ? '' : name}
    aria-hidden={isMark ? 'true' : undefined}
    class:list={['client-logo h-auto shrink-0 object-contain', isMark ? 'max-h-6 max-w-6' : 'max-h-8 max-w-full']}
    loading="lazy"
    decoding="async"
  />
  {isMark && <span class="client-logo-label whitespace-nowrap text-sm font-semibold leading-none tracking-[-0.04em] text-muted">{name}</span>}
</div>
