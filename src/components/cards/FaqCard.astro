---
interface Props {
  question: string
  answer: string
  class?: string
}

const { question, answer, class: className = '' } = Astro.props
---

<div class:list={['border-b border-neutral-800', className]}>
  <details class="group">
    <summary class="flex items-center justify-between py-5 cursor-pointer list-none text-white font-medium hover:text-neutral-300 transition-colors">
      <span class="pr-4">{question}</span>
      <span class="flex-shrink-0 ml-2 transition-transform duration-200 group-open:rotate-45 text-neutral-500">
        +
      </span>
    </summary>
    <div class="pb-5 text-neutral-400 text-sm leading-relaxed">
      {answer}
    </div>
  </details>
</div>
