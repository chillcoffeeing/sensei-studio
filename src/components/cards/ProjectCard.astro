---
import type { ProjectTone } from '../../data/content'

interface Props {
  title: string
  category: string
  image: string
  alt?: string
  tone?: ProjectTone
  size?: 'feature' | 'standard'
  loadingPriority?: boolean
  class?: string
}

const {
  title,
  category,
  image,
  alt = title,
  tone = 'yellow',
  size = 'standard',
  loadingPriority = false,
  class: className = '',
} = Astro.props

const sizeClasses = {
  feature: 'min-h-[28rem] md:min-h-[38rem]',
  standard: 'min-h-[18rem] md:min-h-[18.95rem]',
}
---

<article class:list={['group relative overflow-hidden bg-panel', sizeClasses[size], className]} data-tone={tone}>
  <img
    src={image}
    alt={alt}
    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.035]"
    loading={loadingPriority ? 'eager' : 'lazy'}
    decoding="async"
  />
  <div class="absolute inset-x-4 bottom-4 flex items-center justify-between gap-4 border border-white/20 bg-panel/95 px-4 py-3 text-white transition-transform duration-300 group-hover:-translate-y-1 sm:inset-x-5 sm:bottom-5 sm:px-5">
    <h3 class="min-w-0 truncate text-[0.68rem] font-semibold uppercase tracking-[0.01em] sm:text-xs">{title}</h3>
    <span class="shrink-0 text-[0.68rem] font-medium text-white/65 sm:text-xs">{category}</span>
  </div>
</article>
