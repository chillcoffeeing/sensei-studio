---
interface Props {
  kind: 'member' | 'placeholder'
  name: string
  role: string
  image?: string
  class?: string
}

const { kind, name, role, image, class: className = '' } = Astro.props
---

<article class:list={['group relative aspect-[0.81] min-h-0 overflow-hidden bg-panel', className]}>
  {kind === 'member' && image ? (
    <img
      src={image}
      alt={`${name}, ${role}`}
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
      loading="lazy"
      decoding="async"
    />
  ) : (
    <div class="absolute inset-0 flex flex-col justify-end bg-panel p-6 text-white">
      <span class="mb-auto text-xs uppercase tracking-[0.08em] text-white/45">Sensei Studio</span>
      <div>
        <h3 class="text-base font-semibold">{name}</h3>
        <p class="mt-1 text-sm font-light text-white/70">{role}</p>
      </div>
    </div>
  )}

  {kind === 'member' && (
    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent px-6 pb-7 pt-20 text-white">
      <h3 class="text-base font-semibold">{name}</h3>
      <p class="mt-1 text-sm font-light text-white/80">{role}</p>
    </div>
  )}
</article>
