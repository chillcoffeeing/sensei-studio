---
import ToolCard from './ToolCard.astro'

interface Tool {
  name: string
  icon: string
}

interface Props {
  name: string
  role: string
  bio: string
  image: string
  tools: Tool[]
  variant?: 'dark' | 'light'
  class?: string
}

const { name, role, bio, image, tools, variant = 'dark', class: className = '' } = Astro.props

const variants = {
  dark: 'bg-neutral-900 border-neutral-800 hover:border-neutral-600 text-white',
  light: 'bg-primary border-black/10 hover:border-black/40 text-black',
}
---

<article class:list={['group p-6 rounded-2xl border transition-all duration-300', variants[variant], className]}>
  <div class="flex items-start gap-4 mb-4">
    <div class:list={['w-16 h-16 rounded-full overflow-hidden flex-shrink-0', variant === 'dark' ? 'bg-neutral-800' : 'bg-neutral-200']}>
      <img
        src={image}
        alt={name}
        class="w-full h-full object-cover"
        loading="lazy"
      />
    </div>
    <div class="min-w-0">
      <h3 class="text-lg font-semibold">{name}</h3>
      <p class:list={['text-sm', variant === 'dark' ? 'text-neutral-500' : 'text-neutral-500']}>{role}</p>
    </div>
  </div>
  <p class:list={['text-sm leading-relaxed mb-4', variant === 'dark' ? 'text-neutral-400' : 'text-black/65']}>{bio}</p>
  <div class="grid grid-cols-3 gap-2">
    {tools.map((tool) => (
      <ToolCard name={tool.name} icon={tool.icon} variant={variant} />
    ))}
  </div>
</article>
