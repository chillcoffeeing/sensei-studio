---
interface Props {
  quote: string
  name: string
  role: string
  company?: string
  featured?: boolean
  class?: string
}

const { quote, name, role, company, featured = false, class: className = '' } = Astro.props
---

<blockquote class:list={['flex h-full flex-col justify-between bg-paper p-6 text-ink md:p-8', className]}>
  <div>
    <span class="mb-5 block text-4xl font-medium leading-none text-lime md:mb-8 md:text-6xl" aria-hidden="true">“</span>
    <p class:list={[featured ? 'text-2xl leading-[1.08] tracking-[-0.045em] md:text-4xl' : 'text-base leading-[1.45] md:text-lg']}>
      “{quote}”
    </p>
  </div>
  <footer class="mt-10 flex items-center gap-3 border-t border-line pt-5">
    <div class="grid size-10 shrink-0 place-items-center bg-lime text-sm font-semibold text-ink" aria-hidden="true">
      {name.charAt(0)}
    </div>
    <div class="min-w-0">
      <cite class="block truncate text-sm font-medium not-italic md:text-base">{name}</cite>
      <span class="block truncate text-xs text-muted md:text-sm">{role}{company ? `, ${company}` : ''}</span>
    </div>
  </footer>
</blockquote>
