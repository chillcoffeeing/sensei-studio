---
import { LinksView } from '@/app/links';
import links from '@/content/links';
import site from '@/content/site';
import StandaloneLayout from '@/layout/StandaloneLayout.astro';

export const prerender = true;
---

{/*
  Destino del enlace de la bio de Instagram. Sin header, barra flotante ni footer del sitio: la
  página trae su cabecera, sus dos caminos (diagnóstico y cotización) y un único WhatsApp en el
  cierre, que la barra flotante duplicaría. Sí el modal de cotización, que abre el tile "Cotizar proyecto".
*/}
<StandaloneLayout seo={links.seo} site={site}>
  <LinksView links={links} />
</StandaloneLayout>
