---
// Texto con saltos de línea fijos del diseño (promesa del hero de proyecto, notas…): una entrada por
// línea, cada una un <span class="block"> dentro del elemento que lo envuelve.
interface Props {
  /** Cada elemento es una línea forzada del texto (salto fijo del diseño). */
  lines: readonly string[];
}

const { lines } = Astro.props;
---

{lines.map((line) => <span class="block">{line}</span>)}
