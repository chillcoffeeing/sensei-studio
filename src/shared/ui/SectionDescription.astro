---
// Descripción del aside de SectionHeader: primera frase en tono fuerte y el resto atenuado (tonos
// de la superficie). El ancho lo pone el contenedor.
import type { ToneText as ToneTextValue } from '@/shared/lib/tone-text';
import ToneText from './ToneText.astro';

interface Props {
  /** Descripción con la primera frase en tono fuerte y el resto en tono atenuado. */
  value: ToneTextValue;
}

const { value } = Astro.props;
---

<p class="font-body text-body text-(color:--tone-muted)"><ToneText value={value} /></p>
