---
// Enlace de columna del footer sobre ink. Caja `block w-fit`: su alto es su interlineado aunque el
// <li> que lo contiene tenga otra fuente.
interface Props {
  label: string;
  /** Sin destino todavía: se pinta como texto con el mismo aspecto. */
  href?: string;
  /** Aviso para lectores de pantalla: si existe, el enlace es externo y abre otra pestaña. */
  newTab?: string;
}

const { label, href, newTab } = Astro.props;
---

{
  href ? (
    <a
      href={href}
      target={newTab ? '_blank' : undefined}
      rel={newTab ? 'noopener noreferrer' : undefined}
      class="block w-fit font-heading text-title text-paper transition-colors duration-(--duration-fast) hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
    >
      {label}
      {newTab && <span class="sr-only"> {newTab}</span>}
    </a>
  ) : (
    <span class="block w-fit font-heading text-title text-paper">{label}</span>
  )
}
