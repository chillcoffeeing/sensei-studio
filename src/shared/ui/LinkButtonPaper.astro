---
// Enlace con forma de botón píldora paper a todo el ancho, sobre glass oscuro ("Ver proyecto" del
// detalle de ProjectCard). Es un <a>: navega. En una card estrecha (@max-md del contenedor) baja el
// relleno vertical; min-h-11 mantiene el área táctil de 44px.
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a
  href={href}
  class="flex min-h-11 w-full items-center justify-center rounded-pill bg-paper px-6 py-3.5 text-center @max-md:py-2.5 font-heading text-button-lg text-ink transition-colors duration-(--duration-fast) ease-standard hover:bg-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper"
>
  {label}
</a>
