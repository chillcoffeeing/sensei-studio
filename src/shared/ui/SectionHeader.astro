---
// Cabecera común de las secciones claras: Eyebrow + título en dos tonos + slot `aside` (descripción
// o LinkMore), que en lg+ va abajo a la derecha y en mobile se apila.
import type { ToneText as ToneTextValue } from '@/shared/lib/tone-text';
import Eyebrow from './Eyebrow.astro';
import ToneText from './ToneText.astro';

interface Props {
  /** id del título: la sección lo referencia con aria-labelledby. */
  headingId: string;
  /** Nivel del título: h2 (por defecto) o h1 en una página sin hero (/proyectos/). Mismo aspecto. */
  level?: 'h1' | 'h2';
  eyebrow: string;
  title: ToneTextValue;
  /**
   * SOLO el ancho máximo del título (`max-w-(--<sección>-title-max)`) que fija su corte de línea.
   * Única prop de clases de la librería: excepción a "sin class desde fuera".
   */
  titleClass?: string;
}

const { headingId, level = 'h2', eyebrow, title, titleClass } = Astro.props;
const Heading = level;
const hasAside = Astro.slots.has('aside');
---

{/*
  data-head-part: marca neutra de las dos partes, sin efecto propio. Una sección que quiera la
  entrada escalonada pone head-parts:reveal-up en su contenedor [data-reveal] e incluye
  [data-head-part] en el selector de items (shared/lib/motion). Sin eso, nada cambia.
*/}
<div
  class:list={[
    'flex flex-col gap-(--section-head-aside-gap) lg:flex-row lg:items-end',
    hasAside && 'lg:justify-between',
  ]}
>
  <div data-head-part class="flex max-w-191 flex-col gap-3.75">
    <Eyebrow text={eyebrow} />
    <Heading id={headingId} class:list={['font-heading text-h2 text-(color:--tone-strong)', titleClass]}>
      <ToneText value={title} />
    </Heading>
  </div>
  {hasAside && <div data-head-part class="shrink-0 lg:text-right"><slot name="aside" /></div>}
</div>
