---
// Pieza interna de TrustBadge: estrellas en un solo role="img" cuyo nombre es `rating.label`; cada
// estrella es decorativa (src/assets/ui/star.svg).
import star from '@/assets/ui/star.svg';
import type { UiRating } from './types';

interface Props {
  /** Estrellas y su texto alternativo ("5 de 5"). */
  rating: UiRating;
}

const { rating } = Astro.props;
---

<span role="img" aria-label={rating.label} class="flex">
  {
    Array.from({ length: rating.stars }, () => (
      <img src={star.src} alt="" width={star.width} height={star.height} class="size-(--rating-star-size)" />
    ))
  }
</span>
