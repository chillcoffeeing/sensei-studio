---
// Título de columna del footer: <h2> pequeño en mayúsculas, ink-muted sobre ink.
interface Props {
  /** Título corto de columna (se pinta en mayúsculas con CSS). */
  text: string;
}

const { text } = Astro.props;
---

<h2 class="font-heading text-overline text-ink-muted uppercase">{text}</h2>
