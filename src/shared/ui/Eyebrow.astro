---
// Rótulo sobre el h2 de una sección: punto lima (src/assets/ui/eyebrow-dot.svg) + texto en
// mayúsculas, en el tono fuerte de la superficie. Los rótulos del caso de estudio, los modales y
// /links usan LabelMarker (marcador cuadrado y texto menor).
import eyebrowDot from '@/assets/ui/eyebrow-dot.svg';

interface Props {
  /** Texto del eyebrow (se pinta en mayúsculas con CSS). */
  text: string;
}

const { text } = Astro.props;
---

<p class="flex items-center gap-2.5 font-heading text-eyebrow text-(color:--tone-strong) uppercase">
  <img src={eyebrowDot.src} width={eyebrowDot.width} height={eyebrowDot.height} alt="" class="block shrink-0" />
  {text}
</p>
