---
// Avatar circular con iniciales: autor de una ReviewCard. Decorativo (aria-hidden): el nombre va
// al lado como texto. Colores: --color-avatar-{1..4}-bg/fg.
import type { AvatarTone } from './types';

interface Props {
  /** Iniciales ya calculadas (shared/lib/initials). */
  initials: string;
  /** Tono de la paleta: dato de posición, no variante. Lo calcula quien reparte las cards (avatarTone del masonry) para que dos contiguas no coincidan. */
  tone: AvatarTone;
}

const { initials, tone } = Astro.props;

// Clases completas (no interpoladas) para que Tailwind las detecte.
const toneClass = {
  1: 'bg-avatar-1-bg text-avatar-1-fg',
  2: 'bg-avatar-2-bg text-avatar-2-fg',
  3: 'bg-avatar-3-bg text-avatar-3-fg',
  4: 'bg-avatar-4-bg text-avatar-4-fg',
} as const;
---

<span
  aria-hidden="true"
  class:list={[
    'flex size-10 shrink-0 items-center justify-center rounded-avatar font-body text-initials',
    toneClass[tone],
  ]}
>
  {initials}
</span>
