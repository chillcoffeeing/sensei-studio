---
// Cierre de /links sobre ink con el ruido de marca: "¿Prefieres escribirnos?" (WhatsApp + sitio),
// la firma "Sin promesas vacías. Solo resultados." y el pie mínimo (wordmark + Privacidad).
import LinksContactReminder from './LinksContactReminder.astro';
import LinksFooterNav from './LinksFooterNav.astro';
import type { LinksClosing } from './schema';

interface Props {
  closing: LinksClosing;
}

const { closing } = Astro.props;
---

<footer class="flex flex-col gap-6 bg-ink px-5 pt-9 pb-6 text-paper surface-noise">
  <LinksContactReminder title={closing.title} whatsapp={closing.whatsapp} site={closing.site} />
  <p class="text-center font-body text-sm text-line">
    {closing.claim.text} <strong class="font-semibold text-paper">{closing.claim.strong}</strong>
  </p>
  <hr class="border-neutral-800" />
  <LinksFooterNav wordmark={closing.wordmark} label={closing.navLabel} links={closing.links} />
</footer>
