---
import type { LinksWhatsApp } from './schema';

interface Props {
  whatsapp: LinksWhatsApp;
}

const { whatsapp } = Astro.props;
const { src } = whatsapp.icon.src;
---

{/*
  224:375: píldora con borde translúcido y el logo de WhatsApp (máscara sobre bg-current, toma el
  color del texto). En una fila de menos de 384px (móvil de 375) junto al CTA de 238px solo cabe el
  círculo con el logo: el texto pasa a sr-only y vuelve desde @sm del contenedor.
  Área táctil de 44px; la píldora visible mide 40, como el CTA.
*/}
<a
  href={whatsapp.href}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex min-h-11 items-center rounded-pill focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
>
  <span
    class="flex h-10 min-w-10 items-center justify-center gap-2 rounded-pill border border-white/30 font-heading text-button-sm whitespace-nowrap text-paper motion-safe:transition-colors motion-safe:duration-(--duration-fast) motion-safe:ease-standard can-hover:group-hover:border-paper can-hover:group-hover:bg-white/10 @sm:px-6"
  >
    <span
      aria-hidden="true"
      class="block size-4 shrink-0 bg-current mask-contain mask-center mask-no-repeat"
      style={`-webkit-mask-image: url(${src}); mask-image: url(${src})`}
    ></span>
    <span class="sr-only @sm:not-sr-only">{whatsapp.label}</span>
    <span class="sr-only">{whatsapp.newTab}</span>
  </span>
</a>
