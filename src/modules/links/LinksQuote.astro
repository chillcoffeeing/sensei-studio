---
import LabelMarker from '@/shared/ui/LabelMarker.svelte';
import LinksQuoteSelector from './LinksQuoteSelector.svelte';
import type { LinksQuote } from './schema';
import { uiIcon } from './ui-icon';

interface Props {
  quote: LinksQuote;
}

const { quote } = Astro.props;
const titleId = 'links-quote-title';
const { services, cta } = quote;
// La isla solo recibe datos serializables: cada icono pasa a URL + dimensiones.
const selector = {
  title: services.title,
  count: services.count,
  checkIcon: uiIcon(services.checkIcon),
  options: services.options.map((option) => ({ value: option.value, label: option.label, icon: uiIcon(option.icon) })),
};
---

{/* 230:1006: la tarjeta sube sobre la cabecera (banda ink de 48px detrás, 230:1007). */}
<section aria-labelledby={titleId} class="relative px-5 pb-7">
  <div aria-hidden="true" class="absolute inset-x-0 top-0 h-12 bg-ink"></div>
  <div class="relative flex flex-col gap-4 rounded-3xl border border-stone-300 bg-paper p-4.5 text-ink shadow-lg">
    <LabelMarker text={quote.label} />
    <div class="flex flex-col gap-1.5">
      <h2 id={titleId} class="font-heading text-2xl/tight font-semibold">{quote.title}</h2>
      <p class="font-body text-sm text-ink-muted">{quote.description}</p>
    </div>
    <LinksQuoteSelector client:visible services={selector} cta={{ label: cta.label, href: cta.href, icon: uiIcon(cta.icon) }} />
    <p class="text-center font-body text-xs text-ink-muted">{quote.note}</p>
  </div>
</section>
