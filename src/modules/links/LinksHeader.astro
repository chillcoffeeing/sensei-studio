---
// Cabecera de /links: atmósfera de la home bajo un velo del 85 % con el ruido de marca, logo, h1 y
// descripción. Sin botones: los dos caminos (diagnóstico y cotización) están en la tarjeta de abajo.
import { Image } from 'astro:assets';
import type { LinksHeader } from './schema';

interface Props {
  header: LinksHeader;
}

const { header } = Astro.props;
const { logo, atmosphere, title, description } = header;
---

<header class="relative isolate overflow-clip bg-ink px-5 pt-9 pb-8 text-paper">
  <Image
    src={atmosphere.src}
    alt={atmosphere.alt}
    widths={[480, 960]}
    sizes="(min-width: 640px) 448px, 100vw"
    loading="eager"
    class="absolute inset-0 -z-10 block size-full object-cover"
  />
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-black/85 surface-noise"></div>

  <div class="flex flex-col items-center gap-3.5 text-center">
    <img src={logo.src.src} width={logo.src.width} height={logo.src.height} alt={logo.alt} class="mb-2 block" />
    <h1 class="font-heading text-3xl/tight font-semibold text-balance">
      {title.map((line) => <span class="block">{line}</span>)}
    </h1>
    <p class="max-w-80 font-body text-base/relaxed text-line text-pretty">{description}</p>
  </div>
</header>
