---
// Tarjeta blanca de /links que sube sobre la cabecera: "Tu proyecto empieza aquí" con los dos
// caminos en 2 columnas (también a 375px). El diagnóstico se abre en LinksDiagnosticDialog (hoja en
// móvil, diálogo desde sm), que vive aquí junto a su disparador; "Cotizar proyecto" abre el modal de
// cotización global (StandaloneLayout) tal cual.
import { FORM_ENDPOINT } from '@/core/forms';
import LabelMarker from '@/shared/ui/LabelMarker.svelte';
import LinksDiagnosticDialog from './LinksDiagnosticDialog.svelte';
import LinksPathTile from './LinksPathTile.astro';
import type { LinksDiagnostic, LinksPaths } from './schema';
import { uiIcon } from './ui-icon';

interface Props {
  paths: LinksPaths;
  diagnostic: LinksDiagnostic;
}

const { paths, diagnostic } = Astro.props;
const titleId = 'links-paths-title';
// La isla solo recibe datos serializables: los iconos pasan a URL + dimensiones.
const { icons, ...copy } = diagnostic;
const islandIcons = { cta: uiIcon(icons.cta), open: uiIcon(icons.open), whatsapp: uiIcon(icons.whatsapp), close: uiIcon(icons.close) };
---

{/* Banda ink de 48px detrás: la tarjeta empieza sobre la cabecera. */}
<section aria-labelledby={titleId} class="relative px-5 pb-8">
  <div aria-hidden="true" class="absolute inset-x-0 top-0 h-12 bg-ink"></div>
  <div class="relative flex flex-col gap-5 rounded-3xl border border-stone-300 bg-paper p-4.5 text-ink shadow-lg">
    <div class="flex flex-col gap-2">
      <p><LabelMarker text={paths.label} /></p>
      <h2 id={titleId} class="font-heading text-2xl/tight font-semibold text-balance">{paths.title}</h2>
      <p class="font-body text-base text-ink-muted">{paths.text}</p>
    </div>
    <ul class="grid grid-cols-2 gap-2.5">
      <li>
        <LinksPathTile tile={paths.diagnostic} badge={paths.diagnostic.badge} featured trigger="data-diagnostic-open" track="clic_diagnostico" />
      </li>
      <li>
        <LinksPathTile tile={paths.quote} trigger="data-quote-open" track="clic_cotizar" />
      </li>
    </ul>
    <p class="border-t border-stone-200 pt-4 text-center font-body text-caption text-ink-muted">{paths.footer}</p>
  </div>
  {/* client:load: el tile del diagnóstico está en el primer pantallazo y es lo primero que se toca. */}
  <LinksDiagnosticDialog client:load copy={copy} icons={islandIcons} endpoint={FORM_ENDPOINT} />
</section>
