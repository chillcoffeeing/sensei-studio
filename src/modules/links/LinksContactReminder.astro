---
// "¿Prefieres escribirnos?" del cierre de /links: el WhatsApp de la página y el acceso al sitio.
import type { Link } from '@/core/content';
import LinksWhatsAppLink from './LinksWhatsAppLink.astro';
import type { LinksWhatsApp } from './schema';

interface Props {
  title: string;
  whatsapp: LinksWhatsApp;
  /** "Visitar bysensei.com". */
  site: Link;
}

const { title, whatsapp, site } = Astro.props;
---

<div class="flex flex-col items-center gap-4 text-center">
  <h2 class="font-heading text-xl font-medium">{title}</h2>
  <LinksWhatsAppLink whatsapp={whatsapp} />
  <a
    href={site.href}
    class="flex min-h-11 items-center rounded-sm px-1 font-body text-sm text-line underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand motion-safe:transition-colors motion-safe:duration-(--duration-fast) motion-safe:ease-standard can-hover:hover:text-paper"
  >
    {site.label}
  </a>
</div>
