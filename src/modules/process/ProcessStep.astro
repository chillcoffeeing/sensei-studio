---
import type { ProcessStep } from './schema';

interface Props {
  step: ProcessStep;
}

const { step } = Astro.props;
---

{/*
  Un paso del proceso (inferido, no existe en Figma; ver progress/impl_SEC-PROCESS.md):
  regla lima de 9px como barra de progreso → número y % → título → descripción.
  data-reveal-item + reveal-up: lo anima el revealAll() de la lista en Section.astro.
*/}
<li data-reveal-item class="flex flex-col reveal-up">
  <span aria-hidden="true" class="relative block h-2.25 overflow-hidden bg-progress-track">
    <span class="absolute inset-y-0 left-0 bg-brand" style={`width: ${step.progress}%`} />
  </span>
  <p class="mt-5.25 flex items-center justify-between font-heading text-eyebrow">
    <span class="text-(color:--tone-muted)">{step.number}</span>
    <span class="text-brand">{`${step.progress}%`}</span>
  </p>
  <h3 class="mt-6 font-heading text-title text-(color:--tone-strong)">{step.title}</h3>
  <p class="mt-3.75 font-body text-body text-(color:--tone-muted)">{step.description}</p>
</li>
