---
import type { MediaRef } from '@/core/content';
import type { ToneText as ToneTextValue } from '@/shared/lib/tone-text';
import ToneText from '@/shared/ui/ToneText.astro';
import HeroBackLink from './HeroBackLink.astro';
import HeroLogo from './HeroLogo.astro';
import HeroStatus from './HeroStatus.astro';
import type { ProjectHeroUi } from './schema';

interface Props {
  /** Id del h1 (lo referencia aria-labelledby de la sección). */
  headingId: string;
  back: ProjectHeroUi['back'];
  status: string;
  name: ToneTextValue;
  category: ToneTextValue;
  logo?: MediaRef;
}

const { headingId, back, status, name, category, logo } = Astro.props;
---

<div class="flex flex-col gap-6 lg:gap-8">
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
    <HeroBackLink href={back.href} label={back.label} marker={back.marker} />
    <HeroStatus label={status} />
  </div>
  <div class="flex flex-col gap-4">
    {logo && <HeroLogo logo={logo} />}
    <h1 id={headingId} class="font-heading text-project-name"><ToneText value={name} /></h1>
  </div>
  <p class="font-heading text-body uppercase"><ToneText value={category} /></p>
</div>
