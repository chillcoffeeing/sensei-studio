---
import type { ToneText as ToneTextValue } from '@/shared/lib/tone-text';
import LabelMarker from '@/shared/ui/LabelMarker.svelte';
import ToneText from '@/shared/ui/ToneText.astro';

interface Props {
  /** Id del h2: nombra la sección. */
  headingId: string;
  label: string;
  title: ToneTextValue;
  lead?: ToneTextValue;
  exclusions?: string;
}

const { headingId, label, title, lead, exclusions } = Astro.props;
---

{/* Etiqueta → h2 → descripción → límites del trabajo, en pequeño. */}
<div class="flex flex-col gap-6 text-ink">
  <div class="flex flex-col gap-4.5">
    <LabelMarker text={label} />
    <h2 id={headingId} class="font-heading text-project-title whitespace-pre-line">
      <ToneText value={title} />
    </h2>
  </div>
  {
    lead && (
      <p class="max-w-150 font-body text-body-lg text-ink-muted">
        <ToneText value={lead} />
      </p>
    )
  }
  {exclusions && <p class="max-w-150 font-body text-meta/normal text-ink-muted">{exclusions}</p>}
</div>
