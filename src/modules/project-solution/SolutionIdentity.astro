---
import TextLines from '@/shared/ui/TextLines.astro';
import SolutionSwatch from './SolutionSwatch.astro';
import type { ProjectSolutionIdentity } from './schema';

interface Props {
  identity: ProjectSolutionIdentity;
  /** Nombre accesible de la paleta. */
  paletteLabel: string;
}

const { identity, paletteLabel } = Astro.props;
// Tope del logotipo por su largo: ~0,56em por carácter, en unidades del ancho de la lámina (cqi).
// Los nombres cortos (Yupa®) se quedan en el token; los largos (Remittven®) no se parten.
const wordmarkFit = `font-size: min(var(--text-project-wordmark), ${(100 / (0.56 * [...identity.wordmark].length)).toFixed(2)}cqi)`;
---

{/*
  Sistema de identidad (Yupa 243:155): lámina tinta con cabecera, logotipo tipográfico y, abajo,
  concepto + paleta. Alto fijo de 440px desde lg (como el medio de al lado); en mobile, el alto
  lo da el contenido con un mínimo.
*/}
<div class="@container flex min-h-90 flex-col justify-between gap-10 rounded-panel bg-ink p-6 text-paper sm:p-9 lg:h-110">
  <div class="flex items-start justify-between gap-4 font-body text-caption uppercase">
    <span>{identity.overline}</span>
    <span>{identity.year}</span>
  </div>
  <p class="font-heading text-project-wordmark wrap-break-word" style={wordmarkFit}>{identity.wordmark}</p>
  <div class="flex flex-wrap items-end justify-between gap-6">
    <p class="font-body text-lg/snug sm:text-xl/snug">
      <TextLines lines={identity.concept} />
    </p>
    <ul aria-label={paletteLabel} class="flex gap-1.5">
      {identity.palette.map((color) => <SolutionSwatch color={color} />)}
    </ul>
  </div>
</div>
