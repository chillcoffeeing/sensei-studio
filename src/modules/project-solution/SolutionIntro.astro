---
import type { ToneText as ToneTextValue } from '@/shared/lib/tone-text';
import LabelMarker from '@/shared/ui/LabelMarker.svelte';
import ToneText from '@/shared/ui/ToneText.astro';

interface Props {
  /** Id del h2: nombra la sección. */
  headingId: string;
  label: string;
  title: ToneTextValue;
  description?: ToneTextValue;
}

const { headingId, label, title, description } = Astro.props;
---

{/* Etiqueta + h2 a la izquierda; descripción abajo a la derecha desde xl. */}
<div class="flex flex-col gap-6 xl:flex-row xl:items-end xl:justify-between xl:gap-16">
  <div class="flex max-w-207.5 flex-col gap-4.5">
    <LabelMarker text={label} />
    <h2 id={headingId} class="font-heading text-project-title whitespace-pre-line text-ink">
      <ToneText value={title} />
    </h2>
  </div>
  {
    description && (
      <p class="max-w-120 font-body text-body/normal text-ink-muted xl:max-w-91.25 xl:shrink-0">
        <ToneText value={description} />
      </p>
    )
  }
</div>
