---
import type { ToneText as ToneTextValue } from '@/shared/lib/tone-text';
import LabelMarker from '@/shared/ui/LabelMarker.svelte';
import ToneText from '@/shared/ui/ToneText.astro';

interface Props {
  /** Id del h2: nombra la sección. */
  headingId: string;
  label: string;
  title: ToneTextValue;
  description?: ToneTextValue;
}

const { headingId, label, title, description } = Astro.props;
---

{/* Invitación: etiqueta (gris) → h2 → descripción. */}
<div class="flex flex-col gap-5.5">
  <div class="text-line">
    <LabelMarker text={label} />
  </div>
  <h2 id={headingId} class="font-heading text-project-contact whitespace-pre-line text-paper">
    <ToneText value={title} />
  </h2>
  {
    description && (
      <p class="max-w-160 font-body text-body-lg text-line">
        <ToneText value={description} />
      </p>
    )
  }
</div>
