---
interface Props {
  label: string;
  value: string;
}

const { label, value } = Astro.props;
---

{/* Rótulo en mayúsculas + valor, con separador inferior. */}
<div class="flex flex-col gap-1.75 border-b border-neutral-300 pb-1.75">
  <dt class="font-heading text-caption text-ink-muted uppercase">{label}</dt>
  <dd class="font-body text-body/normal text-ink">{value}</dd>
</div>
