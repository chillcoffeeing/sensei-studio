---
import type { ToneText as ToneTextValue } from '@/shared/lib/tone-text';
import LabelMarker from '@/shared/ui/LabelMarker.svelte';
import ToneText from '@/shared/ui/ToneText.astro';

interface Props {
  /** Id del h2: nombra la sección. */
  headingId: string;
  label: string;
  title: ToneTextValue;
  lead: string;
  description?: string;
}

const { headingId, label, title, lead, description } = Astro.props;
---

{/* Etiqueta → h2 (saltos de línea del dato) → descripción principal → descripción secundaria en gris. */}
<div class="flex flex-col gap-6">
  <div class="flex flex-col gap-4.5">
    <LabelMarker text={label} />
    <h2 id={headingId} class="font-heading text-project-title whitespace-pre-line text-ink">
      <ToneText value={title} />
    </h2>
  </div>
  <p class="max-w-170 font-body text-project-lead text-ink">{lead}</p>
  {description && <p class="max-w-150 font-body text-body/normal text-ink-muted">{description}</p>}
</div>
