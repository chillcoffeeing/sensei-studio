---
import Section from '../../components/layout/Section.astro'
import Button from '../../components/ui/Button.astro'
import { CTA_FINAL } from '../../data/content'
---

<Section id="cta" bg="accent" class="py-20 md:py-28" ariaLabelledby="cta-heading">
  <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_minmax(280px,420px)] md:items-end md:gap-20">
    <div>
      <p class="mb-5 text-xs font-medium uppercase tracking-[0.08em] text-ink/60">Siguiente paso</p>
      <h2 id="cta-heading" class="max-w-[760px] text-[clamp(3.5rem,8vw,7.8rem)] font-semibold leading-[0.85] tracking-[-0.095em]">
        {CTA_FINAL.headline}<br />
        <span class="text-ink/45">{CTA_FINAL.sub}</span>
      </h2>
    </div>

    <div class="flex max-w-[360px] flex-col items-start gap-6 md:justify-self-end">
      <p class="text-base font-medium leading-[1.35] text-ink/70 md:text-lg">{CTA_FINAL.description}</p>
      <Button href={CTA_FINAL.cta.href} variant="dark" size="lg" withArrow>
        {CTA_FINAL.cta.text}
      </Button>
    </div>
  </div>
</Section>
