---
import Section from '../../components/layout/Section.astro'
import ReviewCard from '../../components/cards/ReviewCard.astro'
import AnimatedSection from '../../components-react/AnimatedSection'
import { REVIEWS, REVIEWS_LIST } from '../../data/content'

const [leadReview, ...supportingReviews] = REVIEWS_LIST
---

<Section id="experiencias" class="overflow-hidden pt-24 pb-20 md:pt-32 md:pb-28">
  <div class="grid items-end gap-10 md:grid-cols-[minmax(0,1fr)_360px] md:gap-20">
    <AnimatedSection client:load>
      <div class="mb-5 flex items-center gap-2 text-xs font-medium uppercase tracking-[0.02em]">
        <span class="size-3.5 rounded-full bg-lime" aria-hidden="true"></span>
        <span>{REVIEWS.label}</span>
      </div>
      <h2 class="text-4xl font-medium leading-[1.08] tracking-[-0.055em] md:text-5xl">
        {REVIEWS.headline}<br />
        <span class="text-muted">{REVIEWS.muted}</span>
      </h2>
      <p class="mt-6 max-w-[46ch] text-sm leading-relaxed text-muted md:text-base">{REVIEWS.note}</p>
    </AnimatedSection>

    <AnimatedSection client:load delay={0.12} className="md:justify-self-end">
      <div class="flex flex-col items-start gap-5 md:items-end">
        <div class="max-w-[310px] border border-line p-5 md:p-6">
          <p class="text-xs font-medium uppercase tracking-[0.08em] text-muted">{REVIEWS.proofEyebrow}</p>
          <p class="mt-4 text-lg font-medium leading-[1.1] tracking-[-0.035em] text-ink">{REVIEWS.proofTitle}</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">{REVIEWS.proofDescription}</p>
        </div>
        <a href="mailto:hola@sensei.studio?subject=Quiero%20compartir%20mi%20experiencia" class="inline-flex items-center gap-4 text-xs font-medium uppercase text-muted transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-lime">
          Comparte tu experiencia
          <span class="text-lg leading-none" aria-hidden="true">+</span>
        </a>
      </div>
    </AnimatedSection>
  </div>

  <div class="mt-12 grid gap-px bg-line md:grid-cols-3 md:mt-16">
    <AnimatedSection client:load className="md:col-span-2">
      <ReviewCard quote={leadReview.quote} name={leadReview.name} role={leadReview.role} featured class="min-h-[23rem] md:min-h-[26rem]" />
    </AnimatedSection>

    <div class="relative hidden min-h-[23rem] overflow-hidden bg-neutral-surface md:block" aria-hidden="true">
      <img src={REVIEWS.wallImage} alt="" class="h-full w-full object-cover object-center opacity-75 grayscale" loading="lazy" decoding="async" />
    </div>

    <div class="grid gap-px bg-line sm:grid-cols-3 md:col-span-3">
      {supportingReviews.map((review, index) => (
        <AnimatedSection client:load delay={(index + 1) * 0.08}>
          <ReviewCard quote={review.quote} name={review.name} role={review.role} class="min-h-[18rem]" />
        </AnimatedSection>
      ))}
    </div>
  </div>
</Section>
