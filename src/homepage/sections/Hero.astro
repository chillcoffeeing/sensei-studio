---
import Section from '../../components/layout/Section.astro'
import Button from '../../components/ui/Button.astro'
import ThemeToggle from '../../components/ui/ThemeToggle.astro'
import DecorativeCircle from '../../components/ui/DecorativeCircle.astro'
import AnimatedSection from '../../components-react/AnimatedSection'
import VideoBackground from '../../components-react/VideoBackground'
import { HERO } from '../../data/content'
---

<Section id="hero" bg="dark" container={false} class="relative min-h-[min(851px,100svh)] overflow-hidden py-4 md:min-h-[851px] md:py-5">
  <VideoBackground
    client:load
    src="/assets/videos/homepage-hero-background.mp4"
    poster="/assets/figma/noise.png"
    className="z-0"
  />

  <div class="relative z-10">
    <nav class="mx-auto flex max-w-330 items-center justify-between gap-4 text-sm text-white" aria-label="Navegación principal">
      <a href="#hero" class="shrink-0" aria-label="Sensei Studio, volver al inicio">
        <img src="/assets/figma/sensei-wordmark.svg" alt="Sensei" class="sensei-wordmark h-auto w-25" />
      </a>

      <div class="hidden items-center gap-12 md:flex">
        <a href="#servicios" class="transition-colors hover:text-lime">Studio</a>
        <a href="#proyectos" class="transition-colors hover:text-lime">Proyectos</a>
        <a href="#cta" class="transition-colors hover:text-lime">Agenda una llamada</a>
      </div>

      <div class="flex items-center gap-2">
        <ThemeToggle />
        <div class="hidden sm:block">
          <Button href={HERO.ctaPrimary.href} size="sm" withArrow>
            {HERO.ctaPrimary.text}
          </Button>
        </div>
        <a href="#cta" class="grid size-9 place-items-center rounded-full bg-lime text-ink transition-transform hover:scale-105 sm:hidden" aria-label="Agendar una reunión">
          <img src="/assets/figma/arrow-right.svg" alt="" class="h-3 w-auto" aria-hidden="true" />
        </a>
      </div>
    </nav>

    <div class="mx-auto flex min-h-[calc(min(851px,100svh)-6rem)] max-w-[1320px] flex-col justify-between pb-10 pt-24 md:min-h-[680px] md:pb-16 md:pt-28">
      <div class="grid gap-16 md:grid-cols-[minmax(0,1fr)_260px] md:items-start md:gap-20">
        <AnimatedSection client:load>
          <h1 class="max-w-[620px] text-[clamp(4.4rem,11vw,10rem)] font-extrabold leading-[0.82] tracking-[-0.095em] text-white">
            {HERO.headline}
          </h1>
          <p class="ml-[clamp(8rem,26vw,24rem)] mt-4 text-[clamp(1.5rem,3.5vw,2.5rem)] font-semibold leading-none tracking-[-0.06em] text-white">
            {HERO.subheadline}
          </p>
        </AnimatedSection>

        <AnimatedSection client:load delay={0.12} className="md:pt-14">
          <ul class="space-y-4 text-base font-medium leading-tight text-white md:text-lg">
            {HERO.services.map((service) => <li>{service}</li>)}
          </ul>
        </AnimatedSection>
      </div>

      <div class="flex flex-col justify-between gap-10 md:flex-row md:items-end">
        <AnimatedSection client:load delay={0.18} className="max-w-[560px]">
          <p class="text-base font-medium leading-tight text-white md:text-xl">{HERO.description}</p>
          <p class="mt-1 text-base leading-tight text-hero-muted md:text-xl">{HERO.supporting}</p>
          <div class="mt-6 flex flex-wrap items-center gap-5">
            <Button href={HERO.ctaPrimary.href} size="sm" withArrow>
              {HERO.ctaPrimary.text}
            </Button>
            <a href={HERO.ctaSecondary.href} class="inline-flex items-center gap-3 text-sm font-medium text-white transition-colors hover:text-lime focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-lime">
              {HERO.ctaSecondary.text}
              <span aria-hidden="true">+</span>
            </a>
          </div>
        </AnimatedSection>

        <AnimatedSection client:load delay={0.28} className="self-end">
          <DecorativeCircle variant="first" />
        </AnimatedSection>
      </div>
    </div>
  </div>

  <div class="lime-rule absolute bottom-0 right-0 z-20 h-[9px] w-[40%]" aria-hidden="true"></div>
</Section>
