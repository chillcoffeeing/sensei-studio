    "var_182da1eabaf7": {
      "type": "variant",
      "label": "Sensei Studio — Hero + FAQ Refresh",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url(\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700;800&display=swap\");\n\n  .hero-texture {\n    background-image: url('/api/local/images/public/assets/figma/hero-noise.png');\n    background-position: center;\n    background-size: 720px 480px;\n  }\n\n  .hero-video {\n    height: 120%;\n    object-fit: cover;\n    object-position: center top;\n  }\n\n  .lime-rule-refresh {\n    background: #e4ff40;\n    clip-path: polygon(0 24%, 100% 0, 100% 100%, 0 100%);\n  }\n\n  .faq-panel {\n    max-height: 0;\n    opacity: 0;\n    overflow: hidden;\n    transition: max-height 300ms cubic-bezier(0.16, 1, 0.3, 1), opacity 220ms ease;\n  }\n\n  .faq-panel[data-open='true'] {\n    opacity: 1;\n  }\n\n  .faq-plus {\n    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1), color 180ms ease;\n  }\n\n  .faq-trigger[aria-expanded='true'] .faq-plus {\n    transform: rotate(45deg);\n    color: #090909;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .faq-panel,\n    .faq-plus {\n      transition: none;\n    }\n  }\n</style>\n<div class=\"min-h-screen bg-white font-sans text-[#090909] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <section class=\"relative h-[851px] overflow-hidden border-b-[9px] border-[#e4ff40] bg-[#090909] text-white\" data-kid=\"1-1\" data-name=\"hero section\" id=\"refresh-hero\">\n        <div aria-hidden=\"true\" class=\"absolute inset-0 z-0 overflow-hidden bg-[#090909]\" data-kid=\"1-1-1\" data-name=\"hero background container\">\n            <div class=\"hero-texture absolute inset-0 opacity-20\" data-kid=\"1-1-1-1\" data-name=\"hero texture overlay\">\n            </div>\n            <video aria-hidden=\"true\" autoplay=\"\" class=\"hero-video absolute inset-0 w-full\" data-dynamic=\"true\" data-kid=\"1-1-1-2\" data-name=\"hero background video\" data-reason=\"video playback managed by script and reduced motion media query\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"/api/local/images/public/assets/figma/hero-noise.png\" preload=\"metadata\" src=\"/api/local/images/public/assets/videos/homepage-hero-background.mp4\" tabindex=\"-1\">\n            </video>\n            <div class=\"absolute inset-0 bg-[rgba(9,9,9,0.74)]\" data-kid=\"1-1-1-3\" data-name=\"hero background dimming layer\">\n            </div>\n        </div>\n        <div class=\"relative z-10\" data-kid=\"1-1-2\" data-name=\"hero content wrapper\">\n            <nav aria-label=\"Navegación principal\" class=\"mx-auto flex max-w-[1320px] items-center justify-between gap-4 px-[60px] pt-[19px] text-sm font-medium text-white\" data-kid=\"1-1-2-1\" data-name=\"main navigation bar\">\n                <a aria-label=\"Sensei Studio, volver al inicio\" class=\"shrink-0\" data-kid=\"1-1-2-1-1\" data-name=\"logo link\" href=\"#refresh-hero\">\n                    <img alt=\"Sensei\" class=\"h-auto w-[99px] brightness-0 invert\" data-kid=\"1-1-2-1-1-1\" data-name=\"company wordmark image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/figma/sensei-wordmark.svg\"/>\n                </a>\n                <div class=\"flex items-center gap-[61px]\" data-kid=\"1-1-2-1-2\" data-name=\"navigation menu links container\">\n                    <a class=\"transition-colors hover:text-[#e4ff40]\" data-kid=\"1-1-2-1-2-1\" data-name=\"studio navigation link\" href=\"#refresh-faq\">\n                        Studio\n                    </a>\n                    <a class=\"transition-colors hover:text-[#e4ff40]\" data-kid=\"1-1-2-1-2-2\" data-name=\"projects navigation link\" href=\"#refresh-hero\">\n                        Proyectos\n                    </a>\n                    <a class=\"transition-colors hover:text-[#e4ff40]\" data-kid=\"1-1-2-1-2-3\" data-name=\"quote navigation link\" href=\"#refresh-faq\">\n                        Cotización\n                    </a>\n                </div>\n                <div class=\"flex items-center gap-2\" data-kid=\"1-1-2-1-3\" data-name=\"utility links container\">\n                    <button aria-label=\"Tema oscuro activo\" aria-pressed=\"true\" class=\"inline-flex items-center gap-2 rounded-full border border-white/30 px-3 py-1.5 text-[10px] font-medium uppercase tracking-[0.04em] text-white/90\" data-kid=\"1-1-2-1-3-1\" data-name=\"theme toggle button\" type=\"button\">\n                        <span aria-hidden=\"true\" class=\"relative h-3.5 w-6 rounded-full border border-current/70\" data-kid=\"1-1-2-1-3-1-1\" data-name=\"theme toggle indicator track\">\n                            <span class=\"absolute left-[0.65rem] top-0.5 size-2 rounded-full bg-current\" data-kid=\"1-1-2-1-3-1-1-1\" data-name=\"theme toggle indicator knob\">\n                            </span>\n                        </span>\n                        Oscuro\n                    </button>\n                    <a class=\"inline-flex min-h-9 items-center justify-center gap-3 whitespace-nowrap rounded-full bg-[#e4ff40] px-4 text-xs font-medium text-[#090909] transition-transform hover:scale-[1.02] active:scale-[0.98]\" data-kid=\"1-1-2-1-3-2\" data-name=\"agenda meeting call-to-action link\" href=\"#refresh-faq\">\n                        Agenda una reunión\n                        <span aria-hidden=\"true\" class=\"text-lg leading-none\" data-kid=\"1-1-2-1-3-2-1\" data-name=\"arrow icon\">\n                            →\n                        </span>\n                    </a>\n                </div>\n            </nav>\n            <div class=\"mx-auto flex h-[716px] max-w-[1320px] flex-col justify-between px-[60px] pb-[64px] pt-[132px]\" data-kid=\"1-1-2-2\" data-name=\"hero main content layout\">\n                <div class=\"grid grid-cols-[minmax(0,1fr)_260px] items-start gap-20\" data-kid=\"1-1-2-2-1\" data-name=\"headline and features grid\">\n                    <div data-kid=\"1-1-2-2-1-1\" data-name=\"headline container\">\n                        <h1 class=\"max-w-[620px] text-[clamp(4.5rem,11.1vw,10rem)] font-extrabold leading-[0.82] tracking-[-0.095em] text-white\" data-kid=\"1-1-2-2-1-1-1\" data-name=\"hero main headline\">\n                            Sensei\n                        </h1>\n                        <p class=\"ml-[270px] mt-4 text-[clamp(1.5rem,3.5vw,2.5rem)] font-semibold leading-none tracking-[-0.06em] text-white\" data-kid=\"1-1-2-2-1-1-2\" data-name=\"hero headline subtext\">\n                            Studio.\n                        </p>\n                    </div>\n                    <ul class=\"space-y-4 pt-[50px] text-base font-medium leading-tight text-white md:text-lg\" data-kid=\"1-1-2-2-1-2\" data-name=\"features list\">\n                        <li data-kid=\"1-1-2-2-1-2-1\" data-name=\"branding feature item\">\n                            Branding e identidad\n                        </li>\n                        <li data-kid=\"1-1-2-2-1-2-2\" data-name=\"marketing feature item\">\n                            Marketing digital y SEO\n                        </li>\n                        <li data-kid=\"1-1-2-2-1-2-3\" data-name=\"ux/ui feature item\">\n                            Diseño UX/UI\n                        </li>\n                        <li data-kid=\"1-1-2-2-1-2-4\" data-name=\"development feature item\">\n                            Desarrollo Web\n                        </li>\n                        <li data-kid=\"1-1-2-2-1-2-5\" data-name=\"automation feature item\">\n                            Automatización & IA\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"flex items-end justify-between gap-10\" data-kid=\"1-1-2-2-2\" data-name=\"description and badge container\">\n                    <div class=\"max-w-[560px] text-base leading-tight md:text-xl\" data-kid=\"1-1-2-2-2-1\" data-name=\"hero value proposition\">\n                        <p class=\"font-medium text-white\" data-kid=\"1-1-2-2-2-1-1\" data-name=\"value proposition primary text\">\n                            No diseñamos pantallas bonitas. Diseñamos resultados.\n                        </p>\n                        <p class=\"mt-1 font-normal text-[#adadad]\" data-kid=\"1-1-2-2-2-1-2\" data-name=\"value proposition secondary text\">\n                            Diseño, desarrollo y automatización con IA para marcas que no quieren esperar meses para ver resultados.\n                        </p>\n                    </div>\n                    <div aria-hidden=\"true\" class=\"relative grid size-[144px] place-items-center text-white\" data-kid=\"1-1-2-2-2-2\" data-name=\"rotating badge container\">\n                        <span class=\"grid size-full place-items-center rounded-full border border-dashed border-white/90 text-center text-[9px] font-medium uppercase leading-[1.1] tracking-[0.05em]\" data-kid=\"1-1-2-2-2-2-1\" data-name=\"rotating text orbit\" style=\"animation: refresh-orbit 18s linear infinite;\">\n                            INNOVACIÓN · RESULTADOS · RAPIDEZ · PREMIUM · CREATIVIDAD\n                        </span>\n                        <span class=\"absolute size-1 rounded-full bg-white\" data-kid=\"1-1-2-2-2-2-2\" data-name=\"center dot indicator\">\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div aria-hidden=\"true\" class=\"lime-rule-refresh absolute bottom-0 right-0 z-20 h-[9px] w-[40%]\" data-kid=\"1-1-3\" data-name=\"decorative lime bottom rule\">\n        </div>\n    </section>\n    <section aria-labelledby=\"refresh-faq-heading\" class=\"min-h-[760px] bg-white px-[60px] py-32 text-[#090909]\" data-kid=\"1-2\" data-name=\"FAQ section\" id=\"refresh-faq\">\n        <div class=\"mx-auto grid w-full max-w-[1320px] grid-cols-[minmax(0,1fr)_520px] gap-20\" data-kid=\"1-2-1\" data-name=\"FAQ content grid\">\n            <div class=\"max-w-[600px]\" data-kid=\"1-2-1-1\" data-name=\"FAQ header container\">\n                <div class=\"mb-4 flex items-center gap-2 text-xs font-medium uppercase tracking-[0.02em]\" data-kid=\"1-2-1-1-1\" data-name=\"FAQ label container\">\n                    <span aria-hidden=\"true\" class=\"size-3.5 rounded-full bg-[#e4ff40]\" data-kid=\"1-2-1-1-1-1\" data-name=\"FAQ label decorator\">\n                    </span>\n                    <span data-kid=\"1-2-1-1-1-2\" data-name=\"FAQ label text\">\n                        FAQ\n                    </span>\n                </div>\n                <h2 class=\"max-w-[560px] text-5xl font-medium leading-[1.04] tracking-[-0.055em]\" data-kid=\"1-2-1-1-2\" data-name=\"FAQ main headline\" id=\"refresh-faq-heading\">\n                    ¿Tienes preguntas?\n                    <br data-kid=\"1-2-1-1-2-1\" data-name=\"line break\"/>\n                    <span class=\"text-[#686868]\" data-kid=\"1-2-1-1-2-2\" data-name=\"FAQ secondary headline text\">\n                        Tenemos respuestas.\n                    </span>\n                </h2>\n            </div>\n            <div class=\"divide-y divide-[rgba(9,9,9,0.24)] border-y border-[rgba(9,9,9,0.24)]\" data-dynamic=\"true\" data-faq-root=\"\" data-kid=\"1-2-1-2\" data-name=\"FAQ accordion list container\" data-reason=\"accordion state managed by script\">\n                <div data-kid=\"1-2-1-2-1\" data-name=\"first FAQ item container\">\n                    <button aria-controls=\"refresh-answer-0\" aria-expanded=\"false\" class=\"faq-trigger flex min-h-[68px] w-full items-center justify-between gap-6 py-5 text-left text-base font-medium text-[#090909] transition-colors hover:text-[#686868] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#e4ff40]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1-1\" data-name=\"first FAQ question trigger\" data-reason=\"aria state and panel visibility toggled by script\" type=\"button\">\n                        <span data-kid=\"1-2-1-2-1-1-1\" data-name=\"first FAQ question text\">\n                            ¿Cuánto tiempo toma un proyecto?\n                        </span>\n                        <span aria-hidden=\"true\" class=\"faq-plus shrink-0 text-xl font-light text-[#686868]\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"first FAQ plus icon\">\n                            +\n                        </span>\n                    </button>\n                    <div class=\"faq-panel\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1-2\" data-name=\"first FAQ answer panel\" data-open=\"false\" data-reason=\"height and visibility toggled by script\" id=\"refresh-answer-0\" role=\"region\">\n                        <p class=\"max-w-[48ch] pb-5 text-sm leading-relaxed text-[#686868]\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"first FAQ answer text\">\n                            Depende del alcance. Definimos un cronograma claro en la primera etapa y lo revisamos contigo durante todo el proceso.\n                        </p>\n                    </div>\n                </div>\n                <div data-kid=\"1-2-1-2-2\" data-name=\"second FAQ item container\">\n                    <button aria-controls=\"refresh-answer-1\" aria-expanded=\"false\" class=\"faq-trigger flex min-h-[68px] w-full items-center justify-between gap-6 py-5 text-left text-base font-medium text-[#090909] transition-colors hover:text-[#686868] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#e4ff40]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-1\" data-name=\"second FAQ question trigger\" data-reason=\"aria state and panel visibility toggled by script\" type=\"button\">\n                        <span data-kid=\"1-2-1-2-2-1-1\" data-name=\"second FAQ question text\">\n                            ¿Trabajan a medida o con plantillas?\n                        </span>\n                        <span aria-hidden=\"true\" class=\"faq-plus shrink-0 text-xl font-light text-[#686868]\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"second FAQ plus icon\">\n                            +\n                        </span>\n                    </button>\n                    <div class=\"faq-panel\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-2\" data-name=\"second FAQ answer panel\" data-open=\"false\" data-reason=\"height and visibility toggled by script\" id=\"refresh-answer-1\" role=\"region\">\n                        <p class=\"max-w-[48ch] pb-5 text-sm leading-relaxed text-[#686868]\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"second FAQ answer text\">\n                            Siempre a medida. Cada proyecto se construye desde cero según las necesidades específicas del cliente.\n                        </p>\n                    </div>\n                </div>\n                <div data-kid=\"1-2-1-2-3\" data-name=\"third FAQ item container\">\n                    <button aria-controls=\"refresh-answer-2\" aria-expanded=\"false\" class=\"faq-trigger flex min-h-[68px] w-full items-center justify-between gap-6 py-5 text-left text-base font-medium text-[#090909] transition-colors hover:text-[#686868] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#e4ff40]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3-1\" data-name=\"third FAQ question trigger\" data-reason=\"aria state and panel visibility toggled by script\" type=\"button\">\n                        <span data-kid=\"1-2-1-2-3-1-1\" data-name=\"third FAQ question text\">\n                            ¿Qué incluyen sus servicios?\n                        </span>\n                        <span aria-hidden=\"true\" class=\"faq-plus shrink-0 text-xl font-light text-[#686868]\" data-kid=\"1-2-1-2-3-1-2\" data-name=\"third FAQ plus icon\">\n                            +\n                        </span>\n                    </button>\n                    <div class=\"faq-panel\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3-2\" data-name=\"third FAQ answer panel\" data-open=\"false\" data-reason=\"height and visibility toggled by script\" id=\"refresh-answer-2\" role=\"region\">\n                        <p class=\"max-w-[48ch] pb-5 text-sm leading-relaxed text-[#686868]\" data-kid=\"1-2-1-2-3-2-1\" data-name=\"third FAQ answer text\">\n                            Combinamos estrategia, diseño, desarrollo y automatización para resolver el reto completo, no solo una parte.\n                        </p>\n                    </div>\n                </div>\n                <div data-kid=\"1-2-1-2-4\" data-name=\"fourth FAQ item container\">\n                    <button aria-controls=\"refresh-answer-3\" aria-expanded=\"false\" class=\"faq-trigger flex min-h-[68px] w-full items-center justify-between gap-6 py-5 text-left text-base font-medium text-[#090909] transition-colors hover:text-[#686868] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#e4ff40]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-4-1\" data-name=\"fourth FAQ question trigger\" data-reason=\"aria state and panel visibility toggled by script\" type=\"button\">\n                        <span data-kid=\"1-2-1-2-4-1-1\" data-name=\"fourth FAQ question text\">\n                            ¿Cómo empiezo?\n                        </span>\n                        <span aria-hidden=\"true\" class=\"faq-plus shrink-0 text-xl font-light text-[#686868]\" data-kid=\"1-2-1-2-4-1-2\" data-name=\"fourth FAQ plus icon\">\n                            +\n                        </span>\n                    </button>\n                    <div class=\"faq-panel\" data-dynamic=\"true\" data-kid=\"1-2-1-2-4-2\" data-name=\"fourth FAQ answer panel\" data-open=\"false\" data-reason=\"height and visibility toggled by script\" id=\"refresh-answer-3\" role=\"region\">\n                        <p class=\"max-w-[48ch] pb-5 text-sm leading-relaxed text-[#686868]\" data-kid=\"1-2-1-2-4-2-1\" data-name=\"fourth FAQ answer text\">\n                            Agenda una reunión de diagnóstico. En una conversación breve evaluamos si encajamos y definimos los siguientes pasos.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n</div>\n<style>\n    @keyframes refresh-orbit {\n    from { transform: rotate(-180deg); }\n    to { transform: rotate(180deg); }\n  }\n</style>\n<script>\n    const faqRoot = document.querySelector('[data-faq-root]');\n  const faqTriggers = faqRoot ? Array.from(faqRoot.querySelectorAll('.faq-trigger')) : [];\n\n  faqTriggers.forEach((trigger) => {\n    trigger.addEventListener('click', () => {\n      const wasOpen = trigger.getAttribute('aria-expanded') === 'true';\n\n      faqTriggers.forEach((item) => {\n        const panel = document.getElementById(item.getAttribute('aria-controls') || '');\n        item.setAttribute('aria-expanded', String(item === trigger && !wasOpen));\n        if (!panel) return;\n        const isOpen = item === trigger && !wasOpen;\n        panel.dataset.open = String(isOpen);\n        panel.style.maxHeight = isOpen ? `${panel.scrollHeight}px` : '0px';\n      });\n    });\n  });\n\n  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n  const video = document.querySelector('.hero-video');\n  if (video instanceof HTMLVideoElement && reduceMotion) video.pause();\n</script>\n",
      "comments": [],
      "created": "2026-08-20T14:47:30.258343+00:00",
      "modified": "2026-08-20T14:47:52.097852+00:00",
